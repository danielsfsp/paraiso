{
  // Site de TESTE do Paraíso (Cloudflare Workers).
  // Cada envio para a branch master publica sozinho em paraiso-teste.
  // site/ = arquivos do app; worker/index.js = serve o site e, pelo
  // agendamento abaixo (a cada 2 dias), mantém o banco Supabase acordado.
  "name": "paraiso-teste",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": { "directory": "./site", "binding": "ASSETS" },
  "triggers": { "crons": ["17 12 */2 * *"] }
}
